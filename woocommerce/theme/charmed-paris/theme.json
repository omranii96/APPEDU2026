{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "velours", "name": "Velours", "color": "#1A1015" },
				{ "slug": "velours-2", "name": "Velours clair", "color": "#2A1520" },
				{ "slug": "velours-fg", "name": "Texte sur velours", "color": "#F2E9EC" },
				{ "slug": "velours-muted", "name": "Texte discret sur velours", "color": "#B9A6AE" },
				{ "slug": "grenat", "name": "Grenat", "color": "#7A1F3A" },
				{ "slug": "or", "name": "Or doux", "color": "#A9813F" },
				{ "slug": "or-clair", "name": "Or clair", "color": "#E9CB8F" },
				{ "slug": "porcelaine", "name": "Porcelaine", "color": "#F4F2F5" },
				{ "slug": "poudre", "name": "Poudre", "color": "#D9C6CC" },
				{ "slug": "surface", "name": "Blanc", "color": "#FFFFFF" },
				{ "slug": "encre", "name": "Encre", "color": "#1C1519" },
				{ "slug": "muted", "name": "Texte discret", "color": "#6B6169" },
				{ "slug": "line", "name": "Filet", "color": "#E2DBE0" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"dropCap": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bodoni Moda",
					"fontFamily": "\"Bodoni Moda\", Didot, \"Bodoni 72\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Bodoni Moda",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [ "file:./assets/fonts/bodoni-moda-latin-wght.woff2" ]
						},
						{
							"fontFamily": "Bodoni Moda",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [ "file:./assets/fonts/bodoni-moda-italic-latin-400.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Jost",
					"fontFamily": "Jost, Futura, \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "300 600",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [ "file:./assets/fonts/jost-latin-wght.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "DM Mono",
					"fontFamily": "\"DM Mono\", ui-monospace, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "DM Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [ "file:./assets/fonts/dm-mono-latin-400.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Très petit", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Petit", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Moyen", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Titre", "size": "3.25rem", "fluid": { "min": "2.125rem", "max": "3.25rem" } },
				{ "slug": "display", "name": "Affiche", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1rem" },
				{ "slug": "40", "name": "4", "size": "1.5rem" },
				{ "slug": "50", "name": "5", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(2.5rem, 5vw, 3.5rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(3.75rem, 8vw, 5.5rem)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "ecrin", "name": "Écrin", "shadow": "0 30px 60px -30px rgba(40,20,30,.45)" }
			]
		},
		"custom": {
			"ease": "cubic-bezier(.2,.8,.2,1)",
			"header-height": "64px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--porcelaine)",
			"text": "var(--wp--preset--color--encre)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "max(16px, env(safe-area-inset-left, 0px))",
				"right": "max(16px, env(safe-area-inset-right, 0px))"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.12"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--grenat)" } }
			},
			"button": {
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--encre)" },
				"color": {
					"background": "var(--wp--preset--color--encre)",
					"text": "var(--wp--preset--color--porcelaine)"
				},
				"spacing": { "padding": { "top": "15px", "bottom": "15px", "left": "24px", "right": "24px" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "13px",
					"fontWeight": "500",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--grenat)", "text": "var(--wp--preset--color--surface)" },
					"border": { "color": "var(--wp--preset--color--grenat)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--or)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "13px", "letterSpacing": "0.1em", "textTransform": "uppercase" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)" }
			},
			"woocommerce/product-price": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page pleine largeur", "postTypes": [ "page" ] }
	]
}
